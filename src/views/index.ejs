<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bienvenido a MediAgenda</title>
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #e0f2fe; 
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Cabecera morada con degradado */
        .header {
            background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%);
            color: white;
            text-align: center;
            padding: 50px 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .header p {
            font-size: 1.1rem;
            opacity: 0.9;
        }

        /* Contenedor principal */
        .main-content {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 50px 20px;
        }

        .cards-container {
            display: flex;
            gap: 40px; 
            max-width: 1100px;
            width: 100%;
            justify-content: center;
            flex-wrap: wrap;
        }

        /* Cuadros grandes y modernos */
        .role-card {
            background: white;
            border-radius: 20px;
            width: 280px; 
            height: 250px; 
            padding: 25px;
            text-align: center;
            text-decoration: none;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border: 2px solid transparent; 
        }

        /* Contenedor circular interno para el dibujo */
        .icon-wrapper {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: #f3f0ff;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            transition: all 0.3s ease;
        }

        /* Brillo celeste pastel resplandeciente en toda la tarjeta */
        .role-card:hover {
            transform: translateY(-10px);
            border-color: #38bdf8; 
            box-shadow: 0 0 25px rgba(56, 189, 248, 0.6), 
                        0 0 50px rgba(56, 189, 248, 0.3); 
        }

        /* Al pasar el mouse, el círculo del ícono también reacciona */
        .role-card:hover .icon-wrapper {
            background: #e0f2fe;
            transform: scale(1.05);
        }

        /* Estilo de los nuevos vectores lineales */
        .role-card svg {
            width: 48px;
            height: 48px;
        }

        /* Texto de los roles */
        .role-card span {
            font-size: 1.4rem; 
            font-weight: 600;
            color: #4c1d95;
            letter-spacing: 0.5px;
        }
    </style>
</head>
<body>

    <header class="header">
        <h1>Bienvenido a MediAgenda</h1>
        <p>Selecciona tu rol para ingresar al sistema de gestión de citas</p>
    </header>

    <main class="main-content">
        <div class="cards-container">
            
            <!-- Definición del degradado morado estilizado -->
            <svg style="width:0; height:0; position:absolute;">
                <linearGradient id="purpleGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#a78bfa" />
                    <stop offset="100%" stop-color="#7c3aed" />
                </linearGradient>
            </svg>

            <!-- Tarjeta Paciente: Ícono minimalista de usuario -->
            <a href="/auth/login?role=paciente" class="role-card">
                <div class="icon-wrapper">
                    <svg viewBox="0 0 24 24" fill="none" stroke="url(#purpleGrad)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
                <span>Paciente</span>
            </a>

            <!-- Tarjeta Médico: Ícono minimalista de estetoscopio -->
            <a href="/auth/login?role=medico" class="role-card">
                <div class="icon-wrapper">
                    <svg viewBox="0 0 24 24" fill="none" stroke="url(#purpleGrad)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                    </svg>
                </div>
                <span>Médico</span>
            </a>

            <!-- Tarjeta Administrador: Ícono minimalista de engranaje perfecto -->
            <a href="/auth/login?role=admin" class="role-card">
                <div class="icon-wrapper">
                    <svg viewBox="0 0 24 24" fill="none" stroke="url(#purpleGrad)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                    </svg>
                </div>
                <span>Administrador</span>
            </a>

        </div>
    </main>

</body>
</html>
