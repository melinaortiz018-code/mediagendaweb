<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bienvenido a MediAgenda</title>
    <!-- Enlace nativo de Bootstrap Icons para asegurar que carguen los dibujitos en Render -->
    <link rel="stylesheet" href="https://jsdelivr.net">
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #e0f2fe; 
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Cabecera morada con degradado */
        .header {
            background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%);
            color: white;
            text-align: center;
            padding: 50px 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .header p {
            font-size: 1.1rem;
            opacity: 0.9;
        }

        /* Contenedor principal */
        .main-content {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 50px 20px;
        }

        .cards-container {
            display: flex;
            gap: 40px; 
            max-width: 1100px;
            width: 100%;
            justify-content: center;
            flex-wrap: wrap;
        }

        /* Cuadros grandes */
        .role-card {
            background: white;
            border-radius: 16px;
            width: 280px; 
            height: 240px; 
            padding: 20px;
            text-align: center;
            text-decoration: none;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease-in-out;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border: 2px solid transparent; 
        }

        /* EFECTO CELESTE PASTEL BRILLOSO (NEÓN) AL PASAR EL MOUSE */
        .role-card:hover {
            transform: translateY(-10px);
            border-color: #38bdf8; /* Borde celeste más vivo */
            /* Combinación de sombras para simular un brillo/resplandor celeste */
            box-shadow: 0 0 20px rgba(56, 189, 248, 0.6), 
                        0 0 40px rgba(56, 189, 248, 0.4),
                        0 10px 30px rgba(0, 0, 0, 0.08); 
        }

        /* Estilo de los nuevos dibujitos (Bootstrap Icons) con degradado morado */
        .role-card i {
            font-size: 4.8rem; 
            margin-bottom: 18px;
            background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: inline-block;
        }

        /* Texto de los roles */
        .role-card span {
            font-size: 1.4rem; 
            font-weight: 600;
            color: #4c1d95;
        }
    </style>
</head>
<body>

    <header class="header">
        <h1>Bienvenido a MediAgenda</h1>
        <p>Selecciona tu rol para ingresar al sistema de gestión de citas</p>
    </header>

    <main class="main-content">
        <div class="cards-container">
            
            <!-- Tarjeta Paciente con ícono de persona -->
            <a href="/auth/login?role=paciente" class="role-card">
                <i class="bi bi-person-fill"></i>
                <span>Paciente</span>
            </a>

            <!-- Tarjeta Médico con ícono de pulso cardíaco/salud -->
            <a href="/auth/login?role=medico" class="role-card">
                <i class="bi bi-heart-pulse-fill"></i>
                <span>Médico</span>
            </a>

            <!-- Tarjeta Administrador con ícono de engranaje -->
            <a href="/auth/login?role=admin" class="role-card">
                <i class="bi bi-gear-fill"></i>
                <span>Administrador</span>
            </a>

        </div>
    </main>

</body>
</html>
