<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bienvenido a MediAgenda</title>
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #e0f2fe; 
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Cabecera morada con degradado */
        .header {
            background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%);
            color: white;
            text-align: center;
            padding: 50px 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .header p {
            font-size: 1.1rem;
            opacity: 0.9;
        }

        /* Contenedor principal */
        .main-content {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 50px 20px;
        }

        .cards-container {
            display: flex;
            gap: 40px; 
            max-width: 1100px;
            width: 100%;
            justify-content: center;
            flex-wrap: wrap;
        }

        /* Cuadros grandes */
        .role-card {
            background: white;
            border-radius: 16px;
            width: 280px; 
            height: 240px; 
            padding: 20px;
            text-align: center;
            text-decoration: none;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease-in-out;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border: 2px solid transparent; 
        }

        /* Brillo celeste pastel resplandeciente */
        .role-card:hover {
            transform: translateY(-10px);
            border-color: #38bdf8; 
            box-shadow: 0 0 20px rgba(56, 189, 248, 0.6), 
                        0 0 40px rgba(56, 189, 248, 0.4),
                        0 10px 30px rgba(0, 0, 0, 0.08); 
        }

        /* Tamaño óptimo para los vectores */
        .role-card svg {
            width: 75px;
            height: 75px;
            margin-bottom: 22px;
            transition: transform 0.3s ease;
        }

        .role-card:hover svg {
            transform: scale(1.05);
        }

        /* Texto de los roles */
        .role-card span {
            font-size: 1.4rem; 
            font-weight: 600;
            color: #4c1d95;
        }
    </style>
</head>
<body>

    <header class="header">
        <h1>Bienvenido a MediAgenda</h1>
        <p>Selecciona tu rol para ingresar al sistema de gestión de citas</p>
    </header>

    <main class="main-content">
        <div class="cards-container">
            
            <!-- Definición global del color degradado morado para los 3 íconos -->
            <svg style="width:0; height:0; position:absolute;">
                <linearGradient id="purpleGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#a78bfa" />
                    <stop offset="100%" stop-color="#7c3aed" />
                </linearGradient>
            </svg>

            <!-- Tarjeta Paciente (Usuario clásico estilizado) -->
            <a href="/auth/login?role=paciente" class="role-card">
                <svg viewBox="0 0 16 16" fill="url(#purpleGradient)">
                    <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                    <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
                </svg>
                <span>Paciente</span>
            </a>

            <!-- Tarjeta Médico (Corazón con línea de pulso real) -->
            <a href="/auth/login?role=medico" class="role-card">
                <svg viewBox="0 0 16 16" fill="url(#purpleGradient)">
                    <path d="M1.475 9C.348 7.822 0 6.376 0 5.123 0 2.511 2.112.4 4.7 1.4c1.332.516 2.418 1.63 3.3 2.766C8.882 3.03 9.968 1.916 11.3 1.4c2.588-1 4.7 1.11 4.7 3.723 0 1.253-.348 2.699-1.475 3.877L8 15 1.475 9zM11.5 5a.5.5 0 0 0 0-1 .5.5 0 0 0 0 1z"/>
                    <path d="M2.5 13.5A.5.5 0 0 1 3 13h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/>
                </svg>
                <span>Médico</span>
            </a>

            <!-- Tarjeta Administrador (Engranaje de configuración perfecto) -->
            <a href="/auth/login?role=admin" class="role-card">
                <svg viewBox="0 0 16 16" fill="url(#purpleGradient)">
                    <path d="M9.405 1.02c-.252-.61-1.12-.61-1.372 0l-.129.31a1.464 1.464 0 0 1-1.62.814l-.329-.062c-.658-.123-1.227.446-1.104 1.104l.062.329c.14.744-.316 1.475-1.012 1.619l-.31.041c-.653.087-.92.833-.48 1.32l.221.246c.501.558.455 1.417-.103 1.916l-.246.22c-.5.447-.417 1.25.185 1.57l.275.147c.66.35.9 1.148.51 1.772l-.173.277c-.378.604.148 1.37.818 1.232l.317-.065c.712-.146 1.417.279 1.599.963l.078.293c.174.654.91.89 1.398.472l.228-.196c.54-.463 1.343-.332 1.713.292l.163.275c.34.57 1.146.61 1.54.08l.183-.245c.44-.588 1.277-.736 1.89-.32l.26.177c.563.38 1.3-.12 1.206-.79l-.04-.287c-.092-.663.352-1.29 1.008-1.414l.288-.054c.663-.124.96-.86.516-1.366l-.197-.225c-.463-.53-.41-1.385.12-1.847l.235-.205c.52-.456.417-1.3-.21-1.58l-.272-.12a1.464 1.464 0 0 1-.814-1.62l.062-.329c.123-.658-.446-1.227-1.104-1.104l-.329.062a1.464 1.464 0 0 1-1.62-.814l-.129-.31zm-1.405 4.73a3.25 3.25 0 1 1 0 6.5 3.25 3.25 0 0 1 0-6.5z"/>
                </svg>
                <span>Administrador</span>
            </a>

        </div>
    </main>

</body>
</html>
