<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bienvenido a MediAgenda</title>
    <!-- Enlace alternativo y robusto para los íconos de FontAwesome -->
    <link rel="stylesheet" href="https://cloudflare.com" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            /* Fondo cambiado a un tono celeste pastel muy suave y limpio */
            background-color: #e0f2fe; 
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Cabecera morada con degradado */
        .header {
            background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%);
            color: white;
            text-align: center;
            padding: 50px 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .header h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .header p {
            font-size: 1.1rem;
            opacity: 0.9;
        }

        /* Contenedor principal */
        .main-content {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 50px 20px;
        }

        .cards-container {
            display: flex;
            gap: 40px; /* Más espacio de separación entre cuadros */
            max-width: 1100px;
            width: 100%;
            justify-content: center;
            flex-wrap: wrap;
        }

        /* Cuadros significativamente más grandes */
        .role-card {
            background: white;
            border-radius: 16px;
            width: 280px; /* Aumentado de 240px a 280px */
            height: 240px; /* Añadida altura fija para que se vean imponentes */
            padding: 20px;
            text-align: center;
            text-decoration: none;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border: 2px solid transparent; /* Preparado para el borde dinámico */
        }

        /* Efecto al pasar el mouse: se eleva y cambia a bordes/sombras celestes pastel */
        .role-card:hover {
            transform: translateY(-8px);
            border-color: #7dd3fc; /* Borde celeste pastel al pasar el cursor */
            box-shadow: 0 20px 35px rgba(125, 211, 252, 0.3); /* Sombra difuminada celeste */
        }

        /* Tamaño de los íconos aumentado */
        .role-card i {
            font-size: 4.5rem; /* Aumentado para rellenar el espacio */
            color: #7c3aed; /* Color morado para que resalte con el fondo celeste */
            margin-bottom: 22px;
        }

        /* Texto de los roles más grande y legible */
        .role-card span {
            font-size: 1.4rem; 
            font-weight: 600;
            color: #4c1d95;
        }
    </style>
</head>
<body>

    <header class="header">
        <h1>Bienvenido a MediAgenda</h1>
        <p>Selecciona tu rol para ingresar al sistema de gestión de citas</p>
    </header>

    <main class="main-content">
        <div class="cards-container">
            
            <!-- Tarjeta Paciente -->
            <a href="/auth/login?role=paciente" class="role-card">
                <i class="fa-solid fa-user-injured"></i>
                <span>Paciente</span>
            </a>

            <!-- Tarjeta Médico -->
            <a href="/auth/login?role=medico" class="role-card">
                <i class="fa-solid fa-user-md"></i>
                <span>Médico</span>
            </a>

            <!-- Tarjeta Administrador -->
            <a href="/auth/login?role=admin" class="role-card">
                <i class="fa-solid fa-user-shield"></i>
                <span>Administrador</span>
            </a>

        </div>
    </main>

</body>
</html>
